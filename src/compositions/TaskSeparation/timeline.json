  "cues": [
    { "s": 0.6, "e": 4.0, "text": "晚上11点，你给他发了条消息。" },
    { "s": 4.0, "e": 7.2, "text": "对方显示<b>已读</b>，三小时没回。", "link": "read" },
    { "s": 7.2, "e": 10.0, "text": "你把聊天记录翻了<b>17遍</b>。", "link": "count" },

    { "s": 18.6, "e": 22.6, "text": "阿德勒心理学管这叫：<b>课题分离</b>。", "link": "label" },
    { "s": 22.8, "e": 27.2, "text": "判断只有一句：<b>后果</b>最终由谁承担？", "link": "q" },
    { "s": 27.4, "e": 31.0, "text": "回不回消息，后果由<b>他</b>承担。", "link": "him", "role": "stuck" },
    { "s": 31.0, "e": 34.0, "text": "所以你翻17遍，是在<b>替别人写作业</b>。", "link": "hw" },

    { "s": 34.6, "e": 38.6, "text": "发不发消息，是<b>你的课题</b>。", "link": "mine", "role": "act" },
    { "s": 38.8, "e": 42.8, "text": "他回不回、怎么想，是<b>他的课题</b>。", "link": "his", "role": "stuck" },
    { "s": 43.0, "e": 47.4, "text": "累，是因为你把他的反应当成了<b>成绩单</b>。", "link": "report", "role": "worse" },
    { "s": 47.6, "e": 52.0, "text": "你在用力控制一件<b>控制不了</b>的事。", "link": "pull", "role": "worse" },

    { "s": 52.6, "e": 56.8, "text": "越界有两种。一种是别人<b>闯进来</b>：", "link": "in", "role": "worse" },
    { "s": 56.8, "e": 60.6, "text": "“考公吧”“该结婚了”“听我的没错”" },
    { "s": 60.8, "e": 64.4, "text": "另一种是你<b>闯过去</b>：讨好、操心、替人做决定。", "link": "out", "role": "worse" },
    { "s": 64.4, "e": 67.0, "text": "结果两边都<b>累</b>。", "link": "tired", "role": "worse" },

    { "s": 67.4, "e": 70.8, "text": "所有事缠成一团的时候——" },
    { "s": 71.0, "e": 74.6, "text": "<b>后果，最终由谁承担？</b>", "slam": true },
    { "s": 75.0, "e": 80.0, "text": "他的放右边，你的放左边，一下就<b>清楚</b>了。", "link": "clear", "role": "act" },

    { "s": 80.6, "e": 85.0, "text": "你的课题：<b>全力以赴</b>，别指望别人替你扛。", "link": "allin", "role": "act" },
    { "s": 85.2, "e": 89.6, "text": "别人的课题：可以表达，可以<b>支持</b>，但不接管。", "link": "support", "role": "act" },
    { "s": 89.8, "e": 94.0, "text": "你可以把马带到水边，但不能<b>替它喝水</b>。", "link": "drink" },
    { "s": 94.0, "e": 98.0, "text": "这不是冷漠，是把<b>选择权</b>还给对方。", "link": "choice", "role": "act" },

    { "s": 98.6, "e": 102.6, "text": "回到那条消息。你把手机<b>扣</b>在桌上。", "link": "phone" },
    { "s": 102.8, "e": 107.0, "text": "他回不回，是<b>他的</b>课题。", "link": "string", "role": "stuck" },
    { "s": 107.2, "e": 111.6, "text": "你今晚睡不睡得好，是<b>你的</b>课题。", "link": "you", "role": "act" },

    { "s": 113.6, "e": 118.4, "text": "你现在最放不下的那件事，是<b>谁的课题</b>？", "link": "ask" }
  ]
}
